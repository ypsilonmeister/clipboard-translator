{
  "manifest_version": 3,
  "name": "Clipboard Translator",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Translate selected text using your local Clipboard Translator app.",
  "permissions": ["contextMenus", "storage", "offscreen", "clipboardWrite", "notifications"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "http://penguin.linux.test/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "options_page": "options.html",
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
